# Byte-compiled / cache
__pycache__/
*.py[cod]

# Training runs and experiment tracking. Nothing under runs/ is released: checkpoints,
# exports, logs and evaluation results all come from experiments/*.sh. Anchored, so
# jetson_repro/runs/ (the shipped device export) is still tracked.
/runs/
wandb/

# Generated revision campaigns stay local. Keep their actual source, recipes,
# concise reports and aggregate tables; omit datasets, models, traces and logs.
/experiments/revision/**
!/experiments/revision/**/
!/experiments/revision/**/*.py
!/experiments/revision/**/*.sh
!/experiments/revision/**/*.md
!/experiments/revision/**/*.yaml
!/experiments/revision/**/*.yml
!/experiments/revision/**/protocol*.json
!/experiments/revision/**/training_spec*.json
!/experiments/revision/**/specs/*.json
!/experiments/revision/**/*summary*.csv
!/experiments/revision/**/results_final.csv
!/experiments/revision/**/results_reconciled.csv
!/experiments/revision/**/final_status.json
!/experiments/revision/**/HANDOVER*.txt
!/experiments/revision/**/handoff*.txt
# Redundant source capsules and vendor copies are provenance snapshots, not code
# to publish. The selected model exports live in jetson_repro/integer_models/.
/experiments/revision/**/frozen/**
/experiments/revision/**/bundle/**
/experiments/revision/**/workstation_sources/**
/experiments/revision/**/code/efficientvit/**
/experiments/revision/**/logs/**
/experiments/revision/**/shards/**
/experiments/revision/**/reference_cache/**
/experiments/revision/**/source_margins/**
/experiments/revision/**/normal_windows/**
/experiments/revision/**/sealed_windows/**

# Downloaded pretrained weights / checkpoints (fetched by datasets/*.sh)
assets/checkpoints/

# Generated figures, written by `bash figures/make_figures.sh` and the qualitative scripts.
assets/sturm_orig/
assets/qual_candidates/
assets/grad_conflict_n.*
assets/qual_N*
assets/tta_error_persistence.*

# An earlier pseudo pool that is no longer used. The current pool is data/pseudo_gdacs/.
data/pseudo/

# Data files under data/ (the Python package itself stays tracked).
# Pseudo-label pool (38 GB) with its indices, built in README step 3:
data/pseudo_gdacs/
data/**/*.pt
# Compression fitting tensors stay local; checkpoints and exports use /data1.
/experiments/revision/compression_v2*/results/*.pt
# 6 MB GEE manifest, rebuilt by data/build_flood_unlabeled_manifest.py:
data/flood_unlabeled_manifest.csv

# Editable/source installs cloned outside the repo tree are unaffected; local
# clones placed inside the repo (e.g. ./efficientvit) shouldn't be committed.
/efficientvit/

# Retired code and notes, kept locally, not part of the release.
wandb/
